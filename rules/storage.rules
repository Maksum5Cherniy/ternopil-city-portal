rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function underLimit(maxSizeMb) {
      return request.resource.size < maxSizeMb * 1024 * 1024;
    }

    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && isImage() && underLimit(3);
    }

    match /places/{placeId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && (isImage() || isPdf()) && underLimit(5);
    }

    match /listings/{uid}/{listingId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid && isImage() && underLimit(3);
    }

    match /moderation/{allPaths=**} {
      allow read, write: if signedIn();
    }
  }
}
