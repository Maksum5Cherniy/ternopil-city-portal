# Firebase client config (do NOT commit real keys)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# App settings
NEXT_PUBLIC_SITE_TITLE=Де Тернопіль
NEXT_PUBLIC_SITE_SHORT_TITLE=Де Тернопіль
NEXT_PUBLIC_SITE_DESCRIPTION=Де Тернопіль - місто, люди, можливості: новини, заклади, події, карта та оголошення Тернополя.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SITE_DOMAIN_LABEL=de-ternopil.ua
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Server-side (do NOT put these in client)
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com
# FIREBASE_PROJECT_ID=your-project-id

# Other
NEXT_PUBLIC_MAP_TILE_SERVER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
