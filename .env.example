# Vercel Neon Postgres Store
DATABASE_URL=

# Optional: comma-separated emails that should receive admin role on register/login
ADMIN_EMAILS=

# Email verification
RESEND_API_KEY=
EMAIL_FROM=Де Тернопіль <noreply@de-ternopil.ua>
RESEND_EMAIL_DOMAIN=de-ternopil.ua

# App settings
NEXT_PUBLIC_SITE_TITLE=Де Тернопіль
NEXT_PUBLIC_SITE_SHORT_TITLE=Де Тернопіль
NEXT_PUBLIC_SITE_DESCRIPTION=Де Тернопіль - місто, люди, можливості: новини, заклади, події, карта та оголошення Тернополя.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_SITE_DOMAIN_LABEL=de-ternopil.ua
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Other
NEXT_PUBLIC_MAP_TILE_SERVER=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Local-only demo seed guard
ALLOW_DEMO_SEED=false
